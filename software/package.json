{
  "name": "inkquay-studio",
  "version": "0.1.0",
  "description": "Inkquay · 私家写手，本地优先的 AI 长篇创作工作台",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "seed": "tsx src/server/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/api-test.mjs",
    "test:ui": "pnpm build && node scripts/ui-test.mjs",
    "test:providers": "node scripts/provider-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.7",
  "dependencies": {
    "docx": "^9.13.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module"
}
